# Copy to .env before running docker compose in production-like environments.
LAYERPILOT_ADMIN_EMAIL=owner@example.com
LAYERPILOT_ADMIN_PASSWORD=change-this-password
LAYERPILOT_ADMIN_NAME=Production Owner
LAYERPILOT_WORKSPACE_NAME=3DSTU FarmFlow Production
# Public URL used by deployment smoke checks and external links.
LAYERPILOT_PUBLIC_URL=http://127.0.0.1:8797
# Optional comma-separated extra browser origins for cross-origin quote portals or admin frontends.
# Production always trusts LAYERPILOT_PUBLIC_URL when it is set and rejects wildcard origins.
LAYERPILOT_CORS_ORIGINS=
# Bind Docker's published port to localhost by default for Nginx/HTTPS proxying.
# Set to 0.0.0.0 only when intentionally exposing :8797 directly.
LAYERPILOT_BIND_ADDRESS=127.0.0.1
# Host port published on LAYERPILOT_BIND_ADDRESS. Keep 8797 for a single deployment.
# When running more than one independent customer environment on the SAME host,
# give each one a unique port (8797, 8798, ...) plus a unique COMPOSE_PROJECT_NAME
# and LAYERPILOT_CONTAINER_NAME so their containers and data volumes never collide.
LAYERPILOT_HOST_PORT=8797
# Compose project + container identity. Change ONLY when co-hosting multiple
# customer environments on one machine (e.g. farmflow-acme). scripts/provision-tenant.sh
# fills these in automatically for a new customer environment.
COMPOSE_PROJECT_NAME=layerpilot
LAYERPILOT_CONTAINER_NAME=layerpilot

# Set true for fresh production deployments so demo/default users are not kept.
LAYERPILOT_DISABLE_DEFAULT_USERS=true
LAYERPILOT_DISABLE_DEMO_LOGIN=true
LAYERPILOT_SESSION_TTL_HOURS=168
LAYERPILOT_SESSION_IDLE_TIMEOUT_HOURS=24
LAYERPILOT_AUTH_LOCK_THRESHOLD=5
LAYERPILOT_AUTH_LOCK_MINUTES=15
LAYERPILOT_METRICS_TOKEN=change-this-metrics-token
# Optional dedicated smoke account for scripts/ubuntu-deploy.sh ops-check.
# Leave blank to use the bootstrap admin credentials loaded from this file.
LAYERPILOT_OPS_EMAIL=
LAYERPILOT_OPS_PASSWORD=
LAYERPILOT_AUTO_BACKUP_ON_MIGRATE=true
LAYERPILOT_DB_ADAPTER=postgres
POSTGRES_DB=farmflow
POSTGRES_USER=farmflow
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://farmflow:change-this-database-password@postgres:5432/farmflow
LAYERPILOT_POSTGRES_SCHEMA=public
LAYERPILOT_POSTGRES_DOCUMENT_KEY=state
LAYERPILOT_POSTGRES_POOL_MAX=10
LAYERPILOT_POSTGRES_CONNECT_TIMEOUT_MS=10000
LAYERPILOT_POSTGRES_IDLE_TIMEOUT_MS=30000
LAYERPILOT_POSTGRES_SSL=false
LAYERPILOT_BACKUP_RETENTION_DAYS=30
LAYERPILOT_PRE_RESTORE_BACKUP=true
LAYERPILOT_POSTGRES_SERVICE=postgres
# API JSON full-file exports are capped to avoid huge in-memory backup responses.
# Use scripts/ubuntu-backup.sh for large production volume/object-storage backups.
LAYERPILOT_FULL_BACKUP_MAX_BYTES=536870912
LAYERPILOT_DEPLOY_LOCK_DIR=/tmp/layerpilot-deploy.lock
# For SQLite document storage, set:
# LAYERPILOT_DB_ADAPTER=sqlite
# and change LAYERPILOT_DB_PATH in docker-compose.yml to /data/layerpilot.sqlite
# Existing JSON/SQLite data can be copied into PostgreSQL with:
# npm run migrate:postgres -- --source ./api/data/layerpilot.db.json --source-adapter json --apply

# Existing group Chatwoot is external to this Compose stack.
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_PANEL_SECRET=

# Modular AI engine. Provider-specific credentials are configured separately.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODE=hybrid
AI_CONFIDENCE_THRESHOLD=0.78

# Background worker for telemetry ticks and OctoPrint/Moonraker polling.
LAYERPILOT_WORKER_ID=layerpilot-worker
LAYERPILOT_WORKER_TELEMETRY=true
LAYERPILOT_WORKER_BRIDGE_POLLING=true
LAYERPILOT_WORKER_TELEMETRY_INTERVAL_MS=5000
LAYERPILOT_WORKER_BRIDGE_POLL_INTERVAL_MS=10000
LAYERPILOT_WORKER_TOKEN=change-this-worker-token

# Optional integrations.
LAYERPILOT_OBJECT_STORAGE_PROVIDER=local
LAYERPILOT_S3_BUCKET=
LAYERPILOT_S3_REGION=us-east-1
LAYERPILOT_S3_ENDPOINT=
LAYERPILOT_S3_PREFIX=layerpilot
LAYERPILOT_S3_FORCE_PATH_STYLE=false
LAYERPILOT_S3_ACCESS_KEY_ID=
LAYERPILOT_S3_SECRET_ACCESS_KEY=
LAYERPILOT_MQTT_URL=
LAYERPILOT_MQTT_TOPIC_PREFIX=layerpilot
LAYERPILOT_MQTT_USERNAME=
LAYERPILOT_MQTT_PASSWORD=
LAYERPILOT_MQTT_QOS=0
LAYERPILOT_MQTT_RETAIN=false
# Server-side CLI slicer. Leave LAYERPILOT_SLICER_CMD empty to auto-detect
# prusa-slicer / orca-slicer on PATH (Ubuntu: sudo apt install prusa-slicer).
# When found, slicer jobs run real --auto-orient + --arrange + support-enabled
# slicing and quote from actual G-code grams/minutes instead of estimates.
LAYERPILOT_SLICER_CMD=
LAYERPILOT_SLICER_ARGS=

# Pinned OrcaSlicer worker (separate from the API and existing Chatwoot).
ORCA_SLICER_VERSION=2.4.2
ORCA_WORKER_ID=layerpilot-orca
ORCA_WORKER_INTERVAL_MS=3000
ORCA_SLICER_TIMEOUT_MS=1200000
# Example paths are mounted read-only from deploy/orcaslicer/profiles.
ORCA_SLICER_SETTINGS_PATH=
ORCA_SLICER_FILAMENT_PATH=

# Customer-portal checkout payment providers (see api/payment-providers.mjs).
# Leave blank to keep a provider showing as "coming soon" / not_configured in the customer portal.
# Field shapes were reverse-engineered from each provider's public docs; verify against the real
# merchant dashboard docs before wiring the actual HTTP calls (currently placeholders, see TODOs
# in api/payment-providers.mjs).
LAYERPILOT_JKOPAY_STORE_ID=
LAYERPILOT_JKOPAY_API_KEY=
LAYERPILOT_LINEPAY_CHANNEL_ID=
LAYERPILOT_LINEPAY_CHANNEL_SECRET=
LAYERPILOT_PAYUNI_MER_ID=
LAYERPILOT_PAYUNI_HASH_KEY=
LAYERPILOT_PAYUNI_HASH_IV=

# Track.TW package-tracking lookup (see api/logistics-tracking.mjs). Track.TW does not publish
# public API docs; contact them for API access before this can make live calls (currently a
# not_configured placeholder until both the key and their docs are in hand).
LAYERPILOT_TRACKTW_API_KEY=
LAYERPILOT_TRACKTW_BASE_URL=https://track.tw

# LINE customer notifications (notify-only; conversations stay in Chatwoot).
# Create a Messaging API channel at the LINE Developers console and paste the
# channel access token. Customer targets resolve from case/CRM lineUserId fields.
LAYERPILOT_LINE_CHANNEL_ACCESS_TOKEN=
# Optional override, defaults to https://api.line.me
LAYERPILOT_LINE_API_BASE=

# Portal quote-thread bridge: messages between customer and specialist sync to this
# Chatwoot inbox (find-or-create contact by email). CS replies in Chatwoot mirror
# back into the portal thread. Find the inbox id in Chatwoot Settings > Inboxes.
CHATWOOT_PORTAL_INBOX_ID=
# API channel identifier (Chatwoot Inboxes > API channel > Identifier); used as source_id prefix
CHATWOOT_API_CHANNEL_IDENTIFIER=
